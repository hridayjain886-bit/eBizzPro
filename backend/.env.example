# PostgreSQL (Neon or any Postgres-compatible cloud DB)
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<username>
DB_PASSWORD=<password>

# JWT
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRATION_MS=604800000

# CORS - comma separated list, or * for all
CLIENT_ORIGIN=*

# SMTP (for OTP verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-app-password>
MAIL_FROM=no-reply@ebizzpro.com

# OTP
VERIFY_OTP_TTL_MINUTES=15

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=<google-oauth-client-id>

# GSTINCheck: kept on the server; never add this to frontend/.env
GSTINCHECK_API_KEY=<gstincheck-api-key>
# GSTINCHECK_BASE_URL=https://sheet.gstincheck.co.in/check

PORT=8080
